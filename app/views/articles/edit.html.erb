<!-- app/views/articles/edit.html.erb -->
<h1 class="main-title">投稿編集</h1>

<%= form_with model: @article, local: true, class: "article-form" do |form| %>
  <div class="form-group">
    <%= form.label :title, 'タイトル', class: "form-label" %>
    <%= form.text_field :title, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= form.label :content, '投稿内容', class: "form-label" %>
    <%= form.text_area :content, class: "form-textarea" %>
  </div>

  <div class="form-actions">
    <%= form.submit '更新する', class: "btn-submit" %>
    <%= link_to '戻る', articles_path, class: "btn-back" %>
  </div>
<% end %>
